FROM python:3.10-slim

# Install system dependencies for PaddleOCR
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    libgomp1 \
    wget \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
# PaddlePaddle CPU version (lighter, no GPU needed)
RUN pip install --no-cache-dir paddlepaddle==2.5.2 -i https://pypi.tuna.tsinghua.edu.cn/simple \
    || pip install --no-cache-dir paddlepaddle==2.5.2

RUN pip install --no-cache-dir \
    paddleocr>=2.7.0 \
    pytesseract>=0.3.10 \
    Pillow>=10.0.0 \
    pdf2image>=1.16.3 \
    opencv-python-headless>=4.8.0 \
    numpy>=1.24.0 \
    pymupdf>=1.23.0 \
    flask>=3.0.0

# Copy OCR service script
COPY docker/python/ocr_service.py .

EXPOSE 5000

CMD ["python", "ocr_service.py"]
