' ============================================================
' DOMAIN 7: AI & RAG
' ============================================================

package "AI & RAG" <<Rectangle>> {
    
    class AIResponseCache <<Entity>> {
        + id: bigint
        + cache_key: string
        + prompt_hash: string
        + original_prompt: text
        + context_metadata: json
        + ai_response: text
        + ai_provider: string
        + ai_model: string
        + usage_count: int
        + last_used_at: datetime
        + similarity_threshold: decimal
        --
        + generateCacheKey(prompt, context): string
        + generatePromptHash(prompt): string
        + calculateSimilarity(p1, p2): float
        + findSimilar(prompt, context): AIResponseCache
        + incrementUsage(): void
        + cleanOldEntries(days): int
        + getStatistics(): array
    }
    
    class AIResponseCacheMongo <<Entity>> {
        + _id: ObjectId
        + cache_key: string
        + response: object
        --
        << MongoDB >>
    }
    
    class DocumentChunk <<Entity>> {
        + id: bigint
        + template_id: bigint
        + kuesioner_upload_id: bigint
        + source_type: string
        + source_id: bigint
        + chunk_text: text
        + chunk_index: int
        + embedding: json
        + metadata: json
        --
        + cosineSimilarity(embedding): float
    }
    
    class EmbeddingsCache <<Entity>> {
        + id: bigint
        + text_hash: string
        + embedding: json
        + provider: string
        --
        + getCached(text): array
        + store(text, embedding): void
    }
    
    class AIEvaluationTest <<Entity>> {
        + id: bigint
        + test_type: enum(ocr,ai_response,rag)
        + input_data: json
        + expected_output: text
        + actual_output: text
        + ground_truth: text
        + metrics: json
        + wer_score: decimal
        + human_score: decimal
        + ragas_scores: json
        --
        + calculateWER(): decimal
        + getAverageHumanScore(): decimal
    }
    
    class AIEvaluationResult <<Entity>> {
        + id: bigint
        + evaluation_batch: string
        + total_tests: int
        + avg_wer: decimal
        + hallucination_rate: decimal
        + ragas_avg_faithfulness: decimal
        + ragas_avg_relevancy: decimal
        + summary: json
        --
        + getOverallQualityScore(): decimal
        + getHallucinationRate(): decimal
    }
}

