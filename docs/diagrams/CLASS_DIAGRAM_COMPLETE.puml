' ============================================================
' DOMAIN 9: SERVICES (Simplified)
' ============================================================

package "Services" <<Rectangle>> {
    
    class UnifiedAIService <<Service>> {
        - claudeService: ClaudeAIService
        - geminiService: GeminiAIService
        --
        + generateText(prompt, provider): string
        + streamText(prompt, provider): Generator
    }
    
    class ClaudeAIService <<Service>> {
        - apiKey: string
        - model: string
        --
        + chat(messages): string
        + stream(messages): Generator
    }
    
    class GeminiAIService <<Service>> {
        - apiKey: string
        - model: string
        --
        + generateContent(prompt): string
    }
    
    class RAGRetrievalService <<Service>> {
        - embeddingService: EmbeddingService
        - vectorDatabase: VectorDatabaseService
        --
        + retrieveRelevantChunks(query, limit): array
        + semanticSearch(query, threshold): array
    }
    
    class EmbeddingService <<Service>> {
        - provider: string
        --
        + generateEmbedding(text): array
        + batchGenerate(texts): array
    }
    
    class LaporanTriwulanService <<Service>> {
        - aiService: UnifiedAIService
        - ragService: RAGRetrievalService
        --
        + generateLaporan(params): LaporanGJM
        + getRelevantContext(periode): array
    }
    
    class LaporanSemesterService <<Service>> {
        - aiService: UnifiedAIService
        - ragService: RAGRetrievalService
        --
        + generateLaporan(params): LaporanGJM
    }
    
    class OCRService <<Service>> {
        - pythonServiceUrl: string
        --
        + extractTextFromImage(file): string
        + processDocument(file): array
    }
    
    class PPTGenerationService <<Service>> {
        --
        + generateFromLaporan(laporan): string
        + createSlides(content): file
    }
    
    class RAGASEvaluationService <<Service>> {
        --
        + evaluateFaithfulness(answer, context): decimal
        + evaluateRelevancy(answer, query): decimal
        + evaluatePrecision(contexts, query): decimal
        + evaluateRecall(contexts, answer): decimal
    }
}

