@startuml CLASS_DIAGRAM_COMPLETE
!define ENTITY_COLOR #E8F5E9
!define VALUE_OBJECT_COLOR #FFF3E0
!define SERVICE_COLOR #E3F2FD
!define CONTROLLER_COLOR #F3E5F5

title Sistem Monitoring Mutu Akademik - Complete Class Diagram
skinparam class {
    BackgroundColor<<Entity>> ENTITY_COLOR
    BackgroundColor<<ValueObject>> VALUE_OBJECT_COLOR
    BackgroundColor<<Service>> SERVICE_COLOR
    BackgroundColor<<Controller>> CONTROLLER_COLOR
    BorderColor Black
    ArrowColor #2C3E50
}
skinparam groupInheritance 2

' ============================================================
' DOMAIN 1: MASTER DATA & AUTHENTICATION
' ============================================================

package "Master Data & Auth" <<Rectangle>> {
    
    class User <<Entity>> {
        + id: bigint
        + name: string
        + email: string
        + username: string
        + password: string
        + role: enum(gjm,gkm,dosen)
        + prodi_id: bigint
        + is_active: boolean
        --
        + isGKM(): boolean
        + isGJM(): boolean
        + isDosen(): boolean
        + getProdiNameAttribute(): string
    }
    
    class Prodi <<Entity>> {
        + id: bigint
        + kode_prodi: string
        + nama_prodi: string
        + nama_singkat: string
        + dosen_kepala_id: bigint
    }
    
    class Dosen <<Entity>> {
        + id: bigint
        + user_id: bigint
        + prodi_id: bigint
        + nama_lengkap: string
        + nidn: string
        + gelar_akademik: string
        + jabatan_akademik: string
        + kontak_email: string
        + is_kaprodi: boolean
        + is_dosen_wali: boolean
        + kelas_wali: string
        --
        + scopeKaprodi(): query
        + scopeDosenWali(): query
    }
    
    class Dosenn <<Entity>> {
        + dosen_id: bigint
        + pegawai_id: bigint
        + nip: string
        + nidn: string
        + nama: string
        + email: string
        + prodi_id: bigint
    }
}

