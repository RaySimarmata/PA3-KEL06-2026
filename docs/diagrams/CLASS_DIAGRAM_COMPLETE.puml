package "Controllers" <<Rectangle>> {
    
    class AuthController <<Controller>> {
        --
        + login(request): Response
        + register(request): Response
        + logout(request): Response
    }
    
    class "GKM::DashboardController" as GKMDashboard <<Controller>> {
        --
        + index(): View
        + getStatistics(): array
        + getMonitoringData(): array
    }
    
    class "GKM::MonitoringRPSController" as GKMMonitoringRPS <<Controller>> {
        --
        + index(): View
        + cekList(): View
        + kirimPengingat(): Response
    }
    
    class "GKM::MonitoringPerkuliahanController" as GKMMonitoringPerkuliahan <<Controller>> {
        --
        + index(): View
        + detail(dosen): View
        + kirimPengingat(): Response
    }
    
    class "GKM::LaporanKuesioneController" as GKMLaporanKuisioner <<Controller>> {
        - laporanService: LaporanKuesioneService
        --
        + index(): View
        + create(): View
        + store(request): Response
        + generateWithAI(request): Response
    }
    
    class "GJM::DashboardController" as GJMDashboard <<Controller>> {
        --
        + index(): View
        + getInstitutionalData(): array
    }
    
    class "GJM::LaporanTriwulanController" as GJMLaporanTriwulan <<Controller>> {
        - laporanService: LaporanTriwulanService
        --
        + index(): View
        + create(): View
        + store(request): Response
        + generateWithAI(request): Response
        + downloadPPT(id): file
    }
    
    class "GJM::BuatPPTController" as GJMBuatPPT <<Controller>> {
        - pptService: PPTGenerationService
        --
        + generate(laporanId): Response
        + preview(laporanId): View
    }
}

