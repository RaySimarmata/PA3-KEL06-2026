digraph PA3_Database {
    rankdir=TB;
    node [shape=record, fontname=Arial];
    edge [color=gray];

    users [label="{<title>USERS|<id>🔑 id|created_at|updated_at|name|email|password|role|<prodi_id>🔗 prodi_id|is_active}", fillcolor=lightblue, style=filled];
    prodi [label="{<title>PRODI|<id>🔑 id|created_at|updated_at|kode_prodi|nama_prodi|<kaprodi_id>🔗 kaprodi_id}", fillcolor=lightblue, style=filled];
    periode_akademik [label="{<title>PERIODE_AKADEMIK|<id>🔑 id|created_at|updated_at|tahun_ajaran|semester|is_active|start_date|end_date}", fillcolor=lightblue, style=filled];
    dosenn [label="{<title>DOSENN|<id>🔑 id|created_at|updated_at|<pegawai_id>🔗 pegawai_id|nama|nidn|email|nomor_telepon}", fillcolor=lightpink, style=filled];
    jadwal_dosen [label="{<title>JADWAL_DOSEN|<id>🔑 id|created_at|updated_at|<pegawai_id>🔗 pegawai_id|kode_mk|nama_mk|kelas|semester|tahun_ajaran}", fillcolor=lightpink, style=filled];
    kuesioner_uploads [label="{<title>KUESIONER_UPLOADS|<id>🔑 id|created_at|updated_at|<user_id>🔗 user_id|file_path|<pegawai_id>🔗 pegawai_id|kode_matakuliah|extracted_data|ai_analysis}", fillcolor=lightgreen, style=filled];
    rps_monitoring_snapshots [label="{<title>RPS_MONITORING_SNAPSHOTS|<id>🔑 id|created_at|updated_at|<prodi_id>🔗 prodi_id|<periode_id>🔗 periode_id|snapshot_data|generated_at}", fillcolor=lightgreen, style=filled];
    perkuliahan_monitoring_snapshots [label="{<title>PERKULIAHAN_MONITORING_SNAPSHOTS|<id>🔑 id|created_at|updated_at|<prodi_id>🔗 prodi_id|<periode_id>🔗 periode_id|snapshot_data|generated_at}", fillcolor=lightgreen, style=filled];
    laporan_gjm [label="{<title>LAPORAN_GJM|<id>🔑 id|created_at|updated_at|<user_id>🔗 user_id|<template_id>🔗 template_id|jenis_laporan|judul_laporan|ai_konten_preview}", fillcolor=lightyellow, style=filled];
    laporan_bulanan [label="{<title>LAPORAN_BULANAN|<id>🔑 id|created_at|updated_at}", fillcolor=lightyellow, style=filled];
    template_laporan [label="{<title>TEMPLATE_LAPORAN|<id>🔑 id|created_at|updated_at|nama_template|jenis_laporan|file_path|<prodi_id>🔗 prodi_id|is_active}", fillcolor=lightyellow, style=filled];
    laporan_gkm [label="{<title>LAPORAN_GKM|<id>🔑 id|created_at|updated_at|<user_id>🔗 user_id|file_path|jenis_laporan|tahun|status}", fillcolor=lightyellow, style=filled];
    document_chunks [label="{<title>DOCUMENT_CHUNKS|<id>🔑 id|created_at|updated_at|<template_id>🔗 template_id|chunk_index|content|embedding}", fillcolor=plum, style=filled];
    embeddings_cache [label="{<title>EMBEDDINGS_CACHE|<id>🔑 id|created_at|updated_at|hash|embedding|model_name|created_at}", fillcolor=plum, style=filled];
    jadwal_reminder [label="{<title>JADWAL_REMINDER|<id>🔑 id|created_at|updated_at|<user_id>🔗 user_id|<prodi_id>🔗 prodi_id|jenis_reminder|jadwal_kirim|is_active}", fillcolor=orange, style=filled];
    log_email [label="{<title>LOG_EMAIL|<id>🔑 id|created_at|updated_at|<prodi_id>🔗 prodi_id|<reminder_id>🔗 reminder_id|recipient|subject|status|sent_at}", fillcolor=orange, style=filled];
    kirim_laporan_history [label="{<title>KIRIM_LAPORAN_HISTORY|<id>🔑 id|created_at|updated_at|sent_by|laporan_type|<laporan_id>🔗 laporan_id|recipients|sent_at}", fillcolor=orange, style=filled];
    cache [label="{<title>CACHE|}", fillcolor=lightgray, style=filled];
    jobs [label="{<title>JOBS|}", fillcolor=lightgray, style=filled];

    // Relationships
    users:prodi_id -> prodi:title;
    kuesioner_uploads:user_id -> users:title;
    laporan_gjm:user_id -> users:title;
    laporan_bulanan:user_id -> users:title;
    jadwal_reminder:user_id -> users:title;
    kirim_laporan_history:sent_by -> users:title;
    rps_monitoring_snapshots:prodi_id -> prodi:title;
    perkuliahan_monitoring_snapshots:prodi_id -> prodi:title;
    laporan_bulanan:prodi_id -> prodi:title;
    template_laporan:prodi_id -> prodi:title;
    jadwal_reminder:prodi_id -> prodi:title;
    log_email:prodi_id -> prodi:title;
    rps_monitoring_snapshots:periode_id -> periode_akademik:title;
    perkuliahan_monitoring_snapshots:periode_id -> periode_akademik:title;
    jadwal_dosen:pegawai_id -> dosenn:title;
    laporan_gjm:template_id -> template_laporan:title;
    laporan_bulanan:template_id -> template_laporan:title;
    document_chunks:template_id -> template_laporan:title;
    log_email:reminder_id -> jadwal_reminder:title;
}
