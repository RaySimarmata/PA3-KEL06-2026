{
    "name": "Generate Laporan GJM",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "generate-laporan-gjm",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.app_url }}/api/laporan-gjm/{{ $json.laporan_id }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Accept",
                            "value": "application/json"
                        }
                    ]
                },
                "options": {}
            },
            "id": "get-laporan-data",
            "name": "Get Laporan Data",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                470,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.app_url }}/api/template/{{ $json.template_id }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "options": {}
            },
            "id": "get-template",
            "name": "Get Template",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                690,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Extract and prepare data for AI\nconst laporan = $input.first().json;\nconst template = $input.all()[1].json;\n\nconst periode = laporan.periode_mulai;\nconst tahun = new Date(periode).getFullYear();\nconst prodi = laporan.program_studi;\nconst instruksi = laporan.instruksi_prompt;\n\n// Build AI prompt\nconst prompt = `Buat laporan triwulan GJM untuk ${prodi} periode ${periode} tahun ${tahun}.\n\nInstruksi: ${instruksi}\n\nOutput JSON dengan 11 field:\n{\n  \"LATAR_BELAKANG\": \"...\",\n  \"DASAR\": \"...\",\n  \"TUJUAN\": \"...\",\n  \"RUANG_LINGKUP\": \"...\",\n  \"PROGRAM_KERJA\": \"...\",\n  \"PELAKSANAAN\": \"...\",\n  \"HAMBATAN\": \"...\",\n  \"PEMECAHAN_MASALAH\": \"...\",\n  \"EVALUASI\": \"...\",\n  \"KESIMPULAN\": \"...\",\n  \"SARAN\": \"...\"\n}\n\nBahasa formal, JSON valid.`;\n\nreturn {\n  laporan_id: laporan.id,\n  prompt: prompt,\n  template_path: template.file_path,\n  periode: periode,\n  tahun: tahun,\n  prodi: prodi,\n  callback_url: $('Webhook Trigger').item.json.callback_url,\n  app_url: $('Webhook Trigger').item.json.app_url\n};"
            },
            "id": "prepare-ai-prompt",
            "name": "Prepare AI Prompt",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                910,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://api.groq.com/openai/v1/chat/completions",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.GROQ_API_KEY }}"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "llama-3.3-70b-versatile"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [{\"role\": \"user\", \"content\": $json.prompt}] }}"
                        },
                        {
                            "name": "temperature",
                            "value": "0.7"
                        },
                        {
                            "name": "max_tokens",
                            "value": "4000"
                        }
                    ]
                },
                "options": {}
            },
            "id": "call-groq-ai",
            "name": "Call Groq AI",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1130,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Parse AI response and prepare placeholders\nconst aiResponse = $input.first().json;\nconst content = aiResponse.choices[0].message.content;\n\n// Clean and parse JSON\nlet placeholders;\ntry {\n  const cleanContent = content.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  placeholders = JSON.parse(cleanContent);\n} catch (e) {\n  throw new Error('Failed to parse AI response: ' + e.message);\n}\n\n// Add metadata placeholders\nconst inputData = $('Prepare AI Prompt').item.json;\nplaceholders.UNIT = 'Gugus Jaminan Mutu Fakultas Vokasi';\nplaceholders.PERIODE = inputData.periode;\nplaceholders.TAHUN = inputData.tahun;\nplaceholders.LAPORAN_TRIWULAN = 'LAPORAN TRIWULAN';\n\nreturn {\n  laporan_id: inputData.laporan_id,\n  placeholders: placeholders,\n  template_path: inputData.template_path,\n  callback_url: inputData.callback_url,\n  app_url: inputData.app_url\n};"
            },
            "id": "parse-ai-response",
            "name": "Parse AI Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1350,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.app_url }}/api/n8n/process-template",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "laporan_id",
                            "value": "={{ $json.laporan_id }}"
                        },
                        {
                            "name": "template_path",
                            "value": "={{ $json.template_path }}"
                        },
                        {
                            "name": "placeholders",
                            "value": "={{ $json.placeholders }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "process-template",
            "name": "Process Template",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1570,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $('Parse AI Response').item.json.callback_url }}",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "laporan_id",
                            "value": "={{ $('Parse AI Response').item.json.laporan_id }}"
                        },
                        {
                            "name": "success",
                            "value": "true"
                        },
                        {
                            "name": "content",
                            "value": "Laporan berhasil di-generate"
                        },
                        {
                            "name": "document_path",
                            "value": "={{ $json.document_path }}"
                        },
                        {
                            "name": "execution_id",
                            "value": "={{ $workflow.id }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "callback-success",
            "name": "Callback Success",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1790,
