    /**
     * Check if text contains markdown tables
     */
    private function containsMarkdownTable($text)
    {
        if (empty($text) || !is_string($text)) {
            return false;
        }
        
        // Check for lines starting with | (standard markdown table)
        $hasTable = preg_match('/^\|.+\|$/m', $text) === 1;
        
        if ($hasTable) {
            Log::info('Markdown table detected in content', [
                'content_preview' => substr($text, 0, 200)
            ]);
        }
        
        return $hasTable;
    }
    
    /**
     * Convert markdown content to Word XML format (WordML)
     * This creates proper Word XML that can be inserted via TemplateProcessor
     */
    private function convertMarkdownToWordXML($markdown)
    {
        if (empty($markdown)) {
            return '';
        }
        
        $xml = '';
        $lines = explode("\n", $markdown);
        $inTable = false;
        $tableRows = [];
        
        foreach ($lines as $line) {
            $trimmedLine = trim($line);
            
            // Detect table row
            if (preg_match('/^\|/', $trimmedLine)) {
                $inTable = true;
                $tableRows[] = $trimmedLine;
            } else {
                // End of table
                if ($inTable && !empty($tableRows)) {
                    $xml .= $this->generateTableXML($tableRows);
                    $tableRows = [];
                    $inTable = false;
                }
                
                // Add paragraph for non-table content
                if (!empty($trimmedLine)) {
                    $escapedText = htmlspecialchars($trimmedLine, ENT_XML1, 'UTF-8');
                    $xml .= '<w:p><w:r><w:t xml:space="preserve">' . $escapedText . '</w:t></w:r></w:p>';
                }
            }
        }
        
        // Handle remaining table
        if ($inTable && !empty($tableRows)) {
            $xml .= $this->generateTableXML($tableRows);
        }
        
        return $xml;
    }
    
    /**
     * Generate WordML XML for a markdown table
     */
    private function generateTableXML($tableRows)
    {
        if (empty($tableRows)) {
            Log::warning('generateTableXML called with empty rows');
            return '';
        }
        
        Log::info('Generating table XML', [
            'row_count' => count($tableRows),
            'first_row' => $tableRows[0] ?? ''
        ]);
        
        // Parse table rows
        $parsedRows = [];
        foreach ($tableRows as $row) {
            $row = trim($row);
            
            // Skip separator rows (|---|---|)
            if (preg_match('/^\|[\s\-:]+\|$/', $row)) {
                Log::debug('Skipping separator row', ['row' => $row]);
                continue;
            }
            
            // Remove outer pipes
            $row = preg_replace('/^\||\|$/', '', $row);
            
            // Split by pipe and trim
            $cells = array_map('trim', explode('|', $row));
            
            // Remove markdown formatting from cells
            $cells = array_map(function($cell) {
                $cell = preg_replace('/\*\*(.+?)\*\*/', '$1', $cell);
                $cell = preg_replace('/\*(.+?)\*/', '$1', $cell);
                $cell = preg_replace('/__(.+?)__/', '$1', $cell);
                $cell = preg_replace('/_(.+?)_/', '$1', $cell);
                return trim($cell);
            }, $cells);
            
            $parsedRows[] = $cells;
            
            Log::debug('Parsed table row', [
                'cell_count' => count($cells),
                'first_cell' => $cells[0] ?? ''
            ]);
        }
        
        if (empty($parsedRows)) {
            Log::warning('No valid rows after parsing');
            return '';
        }
        
        Log::info('Table parsed successfully', [
            'total_rows' => count($parsedRows),
            'columns' => max(array_map('count', $parsedRows))
        ]);
        
        $colCount = max(array_map('count', $parsedRows));
        $cellWidth = (int) (9000 / $colCount);
        
        // Generate Word XML for table
        $xml = '<w:tbl>';
        
        // Table properties
        $xml .= '<w:tblPr>';
        $xml .= '<w:tblW w:w="9000" w:type="dxa"/>';
        $xml .= '<w:tblBorders>';
        $xml .= '<w:top w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '<w:left w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '<w:bottom w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '<w:right w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '<w:insideH w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '<w:insideV w:val="single" w:sz="6" w:color="999999"/>';
        $xml .= '</w:tblBorders>';
        $xml .= '</w:tblPr>';
        
        // Add table rows
        foreach ($parsedRows as $rowIdx => $cells) {
            $isHeader = ($rowIdx === 0);
            
            $xml .= '<w:tr>';
            
            for ($i = 0; $i < $colCount; $i++) {
                $cellText = isset($cells[$i]) ? htmlspecialchars($cells[$i], ENT_XML1, 'UTF-8') : '';
                
                $xml .= '<w:tc>';
                
                // Cell properties
                $xml .= '<w:tcPr>';
                $xml .= '<w:tcW w:w="' . $cellWidth . '" w:type="dxa"/>';
                
                if ($isHeader) {
                    $xml .= '<w:shd w:val="clear" w:color="auto" w:fill="1F3864"/>';
                }
                
                $xml .= '<w:vAlign w:val="center"/>';
                $xml .= '</w:tcPr>';
                
                // Cell content (paragraph)
                $xml .= '<w:p>';
                $xml .= '<w:pPr>';
                
                if ($isHeader) {
                    $xml .= '<w:jc w:val="center"/>';
                } else {
                    $xml .= '<w:jc w:val="left"/>';
                }
                
                $xml .= '<w:spacing w:after="0"/>';
                $xml .= '</w:pPr>';
                
                // Text run
                $xml .= '<w:r>';
                $xml .= '<w:rPr>';
                $xml .= '<w:rFonts w:ascii="Arial" w:hAnsi="Arial"/>';
                $xml .= '<w:sz w:val="20"/>';  // 10pt
                
                if ($isHeader) {
                    $xml .= '<w:b/>';
                    $xml .= '<w:color w:val="FFFFFF"/>';
                } else {
                    $xml .= '<w:color w:val="000000"/>';
                }
                
                $xml .= '</w:rPr>';
                $xml .= '<w:t xml:space="preserve">' . $cellText . '</w:t>';
                $xml .= '</w:r>';
                $xml .= '</w:p>';
                $xml .= '</w:tc>';
            }
            
            $xml .= '</w:tr>';
        }
        
        $xml .= '</w:tbl>';
        
        // Add paragraph break after table
        $xml .= '<w:p><w:pPr><w:spacing w:after="200"/></w:pPr></w:p>';
        
        Log::info('Table XML generated successfully');
        
        return $xml;
    }
    
    /**
     * Multibyte string pad function (mb_str_pad)
     * PHP doesn't have native mb_str_pad until PHP 8.3
     */
    private function mb_str_pad($input, $pad_length, $pad_string = ' ', $pad_type = STR_PAD_RIGHT)
    {
        $diff = strlen($input) - mb_strlen($input, 'UTF-8');
        return str_pad($input, $pad_length + $diff, $pad_string, $pad_type);
    }
}
