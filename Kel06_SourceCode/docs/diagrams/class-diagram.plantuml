  +role
  +prodi_id
  +is_active
  +
  --
  #casts()
  +dosen()
  +prodi()
  +reminders()
  +isGKM()
  +isGJM()
  +isDosen()
  +getProdiNameAttribute()
}


' Relationships
Ajaran <-- Prodi : belongsTo
Ajaran -->"*" RPS : hasMany
Ajaran -->"*" Monitoring : hasMany
Ajaran -->"*" LaporanGKM : hasMany
DocumentChunk <-- TemplateLaporan : belongsTo
DocumentChunk <-- KuesioneUpload : belongsTo
Dosen <-- User : belongsTo
Dosen <-- Prodi : belongsTo
Dosen -->"*" RPS : hasMany
Dosen -->"*" Materi : hasMany
Dosen -->"*" Monitoring : hasMany
Dosen -->"*" Perwaliaan : hasMany
Dosen -->"*" JawabanKuisioner : hasMany
Dosen -->"*" LaporanGKM : hasMany
Dosen -->"*" EvaluasiArtefak : hasMany
Dosen "*"--"*" Matakuliah : belongsToMany
EvaluasiArtefak <-- Dosen : belongsTo
EvaluasiArtefak <-- RPS : belongsTo
JadwalDosen <-- Dosenn : belongsTo
JadwalReminder <-- User : belongsTo
JawabanKuisioner <-- Kuisioner : belongsTo
JawabanKuisioner <-- PertanyaanKuisioner : belongsTo
JawabanKuisioner <-- Dosen : belongsTo
Kelas <-- Prodi : belongsTo
KirimLaporanHistory <-- User : belongsTo
KuesioneUpload <-- User : belongsTo
Kuisioner -->"*" PertanyaanKuisioner : hasMany
Kuisioner -->"*" JawabanKuisioner : hasMany
LaporanBulanan <-- User : belongsTo
LaporanBulanan <-- TemplateLaporan : belongsTo
LaporanBulanan <-- PeriodeAkademik : belongsTo
LaporanGJM <-- Ajaran : belongsTo
LaporanGJM <-- TemplateLaporan : belongsTo
LaporanGJM <-- User : belongsTo
LaporanGJM <-- User : belongsTo
LaporanGKM <-- Prodi : belongsTo
LaporanGKM <-- User : belongsTo
LaporanGKM <-- TemplateLaporan : belongsTo
LaporanGKM <-- Ajaran : belongsTo
LaporanGKM <-- User : belongsTo
LogEmail <-- Reminder : belongsTo
LogEmail <-- Prodi : belongsTo
Matakuliah <-- Prodi : belongsTo
Matakuliah -->"*" RPS : hasMany
Matakuliah "*"--"*" Dosen : belongsToMany
Materi <-- RPS : belongsTo
Materi <-- Matakuliah : belongsTo
Materi <-- Dosen : belongsTo
Materi --> EvaluasiArtefak : hasOne
Materi -->"*" Monitoring : hasMany
MatkulDosen <-- Dosenn : belongsTo
Monitoring <-- Dosen : belongsTo
Monitoring <-- Matakuliah : belongsTo
Monitoring <-- Ajaran : belongsTo
Monitoring <-- RPS : belongsTo
Monitoring <-- Materi : belongsTo
PencapaianKPI <-- Prodi : belongsTo
PerkuliahanMonitoringDetail <-- Dosenn : belongsTo
PerkuliahanMonitoringSnapshot <-- Dosenn : belongsTo
PerkuliahanMonitoringSnapshot <-- Prodi : belongsTo
PertanyaanKuisioner <-- Kuisioner : belongsTo
PertanyaanKuisioner -->"*" JawabanKuisioner : hasMany
Perwaliaan <-- Dosen : belongsTo
Prodi <-- Dosen : belongsTo
Prodi -->"*" Dosen : hasMany
Prodi -->"*" Matakuliah : hasMany
Prodi -->"*" LaporanGKM : hasMany
RPS <-- Matakuliah : belongsTo
RPS <-- Ajaran : belongsTo
RPS <-- Dosen : belongsTo
RPS --> EvaluasiArtefak : hasOne
RPS -->"*" Monitoring : hasMany
Reminder <-- User : belongsTo
Reminder <-- User : belongsTo
Reminder -->"*" LogEmail : hasMany
RpsMonitoringSnapshot <-- Dosenn : belongsTo
RpsMonitoringSnapshot <-- Prodi : belongsTo
TemplateLaporan <-- Prodi : belongsTo
TemplateLaporan <-- User : belongsTo
TemplateLaporan -->"*" LaporanBulanan : hasMany
User <-- Prodi : belongsTo
User --> Dosen : hasOne
User -->"*" Reminder : hasMany

@enduml
