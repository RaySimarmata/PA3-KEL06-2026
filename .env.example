APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=gkmgjm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Agent Configuration (REQUIRED for Pure AI Agent)
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Advanced RAG Configuration
VECTOR_DB_ENABLED=false
EMBEDDING_PROVIDER=simple
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.3

# ========================================
# AI & RAG CONFIGURATION
# ========================================

# === ANTHROPIC CLAUDE (Primary - RECOMMENDED) ===
# Get API key from: https://console.anthropic.com/
# Claude provides best quality for document analysis and report generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === GROQ (Fast Fallback) ===
# Get free API key from: https://console.groq.com/
# Fast inference with Llama models
LLM_ENABLED=true
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# === OPENROUTER (Alternative Fallback) ===
# Get API key from: https://openrouter.ai/
# Access to multiple models including free options
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# === OLLAMA (Local LLM - Optional) ===
# Install Ollama: https://ollama.ai
# Run: ollama pull llama3:8b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:8b-instruct

# ========================================
# ADVANCED RAG CONFIGURATION
# ========================================

# Enable Vector Database for Advanced RAG
# Set to true to use semantic search with embeddings
# Set to false to use simple RAG (aggregation only)
VECTOR_DB_ENABLED=true

# Enable Template Structure Awareness
# Set to true to use advanced template structure learning
# This will analyze template format, sections, and patterns
TEMPLATE_STRUCTURE_AWARE=true

# Embedding Provider Configuration
# Options: 'local' (Ollama), 'openai', 'simple' (fallback)
EMBEDDING_PROVIDER=local

# === LOCAL EMBEDDINGS (Ollama - RECOMMENDED) ===
# Recommended models:
# - bge-small-en (384 dimensions, fast)
# - nomic-embed-text (768 dimensions, accurate)
# - intfloat/e5-base (768 dimensions)
# Run: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# === OPENAI EMBEDDINGS (Alternative) ===
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your_openai_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.3

# ========================================
# EXTERNAL API CONFIGURATION
# ========================================

# Library API dengan auto-refresh token menggunakan username/password
# Token akan otomatis di-refresh setiap ~58 menit dan retry saat expired (401)
LIBRARY_API_URL=https://cis-dev.del.ac.id/api
LIBRARY_API_USERNAME=your_username
LIBRARY_API_PASSWORD=your_password

# ========================================
# n8n WORKFLOW AUTOMATION (OPTIONAL)
# ========================================

# Enable n8n for async report generation
# Set to true to use n8n workflows instead of direct processing
N8N_ENABLED=false

# n8n Webhook URL (self-hosted or cloud)
# Self-hosted: http://localhost:5678
# Cloud: https://your-instance.app.n8n.cloud
N8N_WEBHOOK_URL=http://localhost:5678

# n8n API Key (optional, for authenticated webhooks)
N8N_API_KEY=

# Timeout for n8n webhook calls (seconds)
N8N_TIMEOUT=300

# ========================================
# OCR & GEMINI AI CONFIGURATION (FREE TIER)
# ========================================

# === GOOGLE GEMINI AI (FREE TIER) ===
# Get free API key from: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests/day, 15 RPM
# Model: gemini-1.5-flash (fast and free)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# === OCR ENGINE CONFIGURATION ===
# Primary OCR Engine: paddleocr (RECOMMENDED)
# PaddleOCR provides better accuracy for Indonesian text and supports PDF scans
OCR_ENGINE=paddleocr
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL=604800

# === PADDLEOCR CONFIGURATION ===
# PaddleOCR is a deep learning-based OCR with excellent accuracy
# Installation: conda activate paddleocr && pip install paddleocr pymupdf
# Ganti YourUser dengan username Windows Anda
PADDLEOCR_PYTHON_PATH="C:\Users\YourUser\anaconda3\envs\paddleocr\python.exe"
PADDLEOCR_LANGUAGE=en
PADDLEOCR_TIMEOUT=120

# === TESSERACT OCR CONFIGURATION (FALLBACK) ===
# Tesseract is open source and runs locally
# Windows Install: https://github.com/UB-Mannheim/tesseract/wiki
# Linux Install: sudo apt-get install tesseract-ocr tesseract-ocr-ind tesseract-ocr-eng
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_LANGUAGES=eng+ind
TESSERACT_PSM=6
TESSERACT_OEM=3

# Gemini Cache Settings
GEMINI_CACHE_ENABLED=true
GEMINI_CACHE_TTL_HOURS=24

# OCR Logging
OCR_LOGGING_ENABLED=true
OCR_LOGGING_LEVEL=info
